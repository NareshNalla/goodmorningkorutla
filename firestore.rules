rules_version = '2';
// Good Morning Korutla — Firestore rules
// Public can read published posts; only signed-in admins can write.
// Apply in Firebase console: Firestore Database → Rules → paste & publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if resource.data.status == "published";
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // legacy collection from the v1 site (read-only in v2)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
